{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Identity": ""
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "chatfusion-api",
    "AccessTokenLifetime": "00:15:00",
    "ClockSkew": "00:00:30",
    "SigningKeyPath": "",
    "PreviousSigningKeyPath": ""
  },
  "Sessions": {
    "AbsoluteLifetime": "30.00:00:00",
    "InactivityTimeout": "7.00:00:00",
    "RotationGracePeriod": "00:00:30"
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "Duration": "00:15:00"
  },
  "PasswordHashing": {
    "Iterations": 600000
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "Window": "00:01:00"
  },
  "Cookies": {
    "Secure": true
  },
  "Cleanup": {
    "Enabled": true,
    "Interval": "01:00:00",
    "RetentionPeriod": "7.00:00:00",
    "BatchSize": 1000
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Scalar": {
    "Enabled": false
  }
}
