<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Создание базы данных и применение миграций Identity. Содержит миграции EF Core.
    Запускается отдельно от сервиса: из IDE, командной строки или контейнером identity-migrator.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>8bcbe2c6-0032-448a-bcd8-11d725b7ed21</UserSecretsId>
    <!-- Как у сервиса: dotnet run выполняется в папке проекта, относительные пути считаются от неё -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\ChatFusion.Identity.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
