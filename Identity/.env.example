# Скопируйте в .env и задайте свои значения. Файл .env в git не попадает.

# PostgreSQL. Пароль совпадает с appsettings.Development.json только для локальной разработки
POSTGRES_DB=chatfusion_identity
POSTGRES_USER=identity
POSTGRES_PASSWORD=identity_dev
POSTGRES_PORT=5440

# Сервис
IDENTITY_PORT=5080
# Публичный адрес сервиса: значение claim iss. Другие сервисы указывают его как ValidIssuer
IDENTITY_ISSUER=http://localhost:5080
IDENTITY_AUDIENCE=chatfusion-api
# false только для локального запуска по HTTP
COOKIES_SECURE=false
SCALAR_ENABLED=true

# Первый администратор. Пароль — в файле secrets/admin-password.txt
ADMIN_EMAIL=admin@chatfusion.local
